{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    // gateway напрямую в OpenRouter, без LiteLLM.
    // Чтобы вернуть LiteLLM: baseURL http://localhost:4000/v1, apiKey {env:LITELLM_MASTER_KEY}, убрать id у моделей.
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "laguna-coder-cloud-free": {
          "id": "poolside/laguna-s-2.1:free",
          "name": "Laguna S 2.1 (облако)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "nemotron-chat-cloud-free": {
          "id": "nvidia/nemotron-3-ultra-550b-a55b:free",
          "name": "Nemotron 3 Ultra (облако)",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 32768 }
        },
        // Лёгкие задачи [лёгкая] — см. PROCESS.md в проектах. Платные, но дешёвые.
        // Вышла новая версия — меняется только id здесь.
        "glm-coder-cloud": {
          "id": "z-ai/glm-5.3-flash",
          "name": "GLM 5.3 Flash (облако)",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 32768 }
        },
        "deepseek-coder-cloud": {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash (облако)",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 32768 }
        }
      }
    }
  },
  "model": "gateway/laguna-coder-cloud-free"
}
