{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "smart":       { "name": "Claude (умный)" },
        "open-cloud":  { "name": "Qwen 480B (облако)" },
        "local":       { "name": "Qwen 30B (локально)" }
      }
    }
  },
  "model": "gateway/smart",
  "agent": {
    "test-writer": {
      "description": "Пишет автотесты по тикету",
      "model": "gateway/open-cloud",
      "prompt": "{file:../prompts/qa-engineer.md}",
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "reviewer": {
      "description": "Ревью сгенерированного кода",
      "model": "gateway/smart",
      "tools": { "write": false, "edit": false, "bash": false }
    }
  }
}
