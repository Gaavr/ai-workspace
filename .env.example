# === КРИТИЧНО: не меняй после первого запуска ===
# Если этот ключ изменится, Open WebUI не сможет расшифровать
# сохранённые credentials инструментов и MCP отвалится молча.
# Сгенерировать: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Ключ LiteLLM из docker-compose (Open WebUI). Нативному шлюзу не нужен:
# он слушает только 127.0.0.1 с постоянным ключом-заглушкой sk-local-gateway.
# Сгенерировать: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# === Провайдеры ===
# Уровень 1 — проприетарное облако
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Уровень 2 — открытые веса в облаке (OpenRouter, Together, Fireworks)
OPENROUTER_API_KEY=
# Та же модель напрямую у автора, резерв OpenRouter. Пусто — алиас выключен.
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Уровень 3 — локальные модели через Ollama (открытая, MIT).
# Нативно, не в Docker: иначе нет Metal-ускорения.
# Ollama запускает scripts/ollama.sh с внешнего SSD (вместе с gateway.sh).
OLLAMA_HOST_URL=http://localhost:11434
# Ollama на отдельной машине в локальной сети:
# OLLAMA_HOST_URL=http://192.168.1.201:11434
# LiteLLM из docker-compose ходит в Ollama через host.docker.internal, это задано там.

# Внешний SSD с моделями и офлайн-комплектом. Меняется, если переименовали том.
AI_SSD="/Volumes/Samsung T7 Shield"
AI_KIT="/Volumes/Samsung T7 Shield/Apps/AI/ai-workspace-kit"

# === MCP ===
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# === Для скрипта синхронизации персон ===
OPENWEBUI_URL=http://localhost:3000
# Создаётся в Open WebUI: Settings -> Account -> API Keys (нужен админский)
OPENWEBUI_API_KEY=
